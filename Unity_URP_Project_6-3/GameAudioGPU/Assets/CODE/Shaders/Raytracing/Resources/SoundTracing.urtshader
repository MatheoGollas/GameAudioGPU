#include "Packages/com.unity.render-pipelines.core/Runtime/UnifiedRayTracing/TraceRayAndQueryHit.hlsl"

UNIFIED_RT_DECLARE_ACCEL_STRUCT(_AccelStruct);

uint _NumEmitters;
StructuredBuffer<float3> _EmitterPositions;
RWStructuredBuffer<int> _RayResults;
float3 _ListenerPos;

void RayGenExecute(UnifiedRT::DispatchInfo dispatchInfo)
{
    uint idx = dispatchInfo.dispatchThreadID.x;
    if (idx >= _NumEmitters)
        return;

    float3 orientationVector = _ListenerPos - _EmitterPositions[idx];
    UnifiedRT::Ray ray;
    ray.origin = _EmitterPositions[idx];
    ray.direction = normalize(orientationVector);
    ray.tMin = 0.01;
    ray.tMax = length(orientationVector) - 0.01 ;
    UnifiedRT::RayTracingAccelStruct accelStruct = UNIFIED_RT_GET_ACCEL_STRUCT(_AccelStruct);
    /*UnifiedRT::Hit hitResult*/bool hasHit = UnifiedRT::TraceRayAnyHit(dispatchInfo, accelStruct, 0xFFFFFFFF, ray, 0);
    
    /*if (hitResult.IsValid())
    {
        // Handle found intersection
    }*/
    _RayResults[idx] = hasHit ? 1 : 0;
}
