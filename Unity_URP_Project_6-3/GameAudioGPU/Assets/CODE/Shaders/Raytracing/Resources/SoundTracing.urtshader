#include "Packages/com.unity.render-pipelines.core/Runtime/UnifiedRayTracing/TraceRayAndQueryHit.hlsl"
#define GOLDEN_ANGLE_DISC 2.39996322973

UNIFIED_RT_DECLARE_ACCEL_STRUCT(_AccelStruct);

uint _NumEmitters;

StructuredBuffer<float4> _EmitterPositions;

#if defined(SOUND_TRACING_DEBUG)
RWStructuredBuffer<float4> _RayResults;
#else
RWStructuredBuffer<float> _RayResults;
#endif

float3 _ListenerPos;

void RayGenExecute(UnifiedRT::DispatchInfo dispatchInfo)
{
    uint3 id = dispatchInfo.dispatchThreadID;
    if (id.x >= _NumEmitters)
        return;

    UnifiedRT::RayTracingAccelStruct accelStruct = UNIFIED_RT_GET_ACCEL_STRUCT(_AccelStruct);
    
    uint3 maxID = dispatchInfo.dispatchDimensionsInThreads;
    uint writeID = id.x * (maxID.y * maxID.z) + id.y * maxID.z + id.z;
    float4 input = _EmitterPositions[id.x];

    float3 directHitVector = _ListenerPos - input.xyz;
    float3 directHitDir = normalize(directHitVector);
    float directHitLength = length(directHitVector);
    float3 midPoint = input.xyz + directHitVector * 0.5;

    float maxRadius = tan(input.w * 0.5) * directHitLength * .5;
    float3 safeVector = directHitDir.y > 0.99 ? float3(0, 0, 1) : float3(0, 1, 0);

    float3 right = normalize(cross(directHitDir, safeVector));
    float3 up = normalize(cross(right, directHitDir));
    
    int firstBit = firstbithigh(id.y); //Smallest power of two
    uint doubleCutCount = 1u << (firstBit + 2); //Determine if we're on a half, quart, eight, and so on

    uint stepMultiplier = id.y & ~(1u << max(firstBit,0)); //Equivalent to subtractring the previous power of 2
    stepMultiplier = stepMultiplier * 2 + 1; //Determine on which half, quart, etc. we are - we don't want a quart to go on a half, etc.

    float interpPlacementStep = 2.0/doubleCutCount;
    float interpPlacement = stepMultiplier * interpPlacementStep;

    uint raysForFirstDisc = interpPlacement * maxID.z;
    int rayID = id.z - raysForFirstDisc;

    bool isFirstDisc = sign(rayID) < 0;

    uint rayCountForDisc = isFirstDisc ? raysForFirstDisc : maxID.z - raysForFirstDisc;

    float3 lerpStart = isFirstDisc ? input.xyz : midPoint;
    float3 lerpEnd = isFirstDisc ? midPoint : _ListenerPos;

    float3 circleMid = lerp(lerpStart, lerpEnd, interpPlacement);

    float circleRadius = maxRadius * (isFirstDisc ? interpPlacement : 1-interpPlacement);

    rayID = abs(rayID);

    float theta = rayID * GOLDEN_ANGLE_DISC;
    float radius = sqrt(rayID / (float)rayCountForDisc);
    radius *= circleRadius;

    float2 samplePoint;
    sincos(theta, samplePoint.y, samplePoint.x);
                
    float2 scaledPoint = samplePoint * radius;

    float3 addVector = right * scaledPoint.x + up * scaledPoint.y;
    float3 rayTarget = circleMid + addVector;

    float3 rayVector = rayTarget - input.xyz;

    float3 nRayVector = normalize(rayVector);

    float2 maxPoint = samplePoint * maxRadius;

    float3 maxAddVector = right * maxPoint.x + up * maxPoint.y;
    float3 maxTarget = circleMid + maxAddVector;
    float3 maxRayVectorDir = normalize(maxTarget - input.xyz); 

    float influence = dot(directHitDir, nRayVector);
    float minInfluence = dot(directHitDir, maxRayVectorDir);
    influence = smoothstep(minInfluence, 1, influence);
    influence *= influence;

    UnifiedRT::Hit hit;
    UnifiedRT::Ray ray;

    ray.origin = input.xyz;
    ray.direction = nRayVector;
    ray.tMin = 0.01;
    ray.tMax = length(rayVector);

    hit = UnifiedRT::TraceRayClosestHit(dispatchInfo, accelStruct, 0xFFFFFFFF, ray, 0);

    float3 newOrigin = hit.IsValid() ? ray.origin + ray.direction * hit.hitDistance : rayTarget;

    float3 listenerVector = _ListenerPos - newOrigin;
    ray.origin = newOrigin;
    ray.direction = normalize(listenerVector);
    ray.tMax = length(listenerVector);
    hit = UnifiedRT::TraceRayClosestHit(dispatchInfo, accelStruct, 0xFFFFFFFF, ray, 0);

    [flatten] if(hit.IsValid()) influence *= 0.5;
    
#if defined(SOUND_TRACING_DEBUG)
    _RayResults[writeID].w = hit.IsValid() ? influence : -influence;
    _RayResults[writeID].xyz = newOrigin;
#else
    _RayResults[writeID] = hit.IsValid() ? influence : -influence;
#endif
}